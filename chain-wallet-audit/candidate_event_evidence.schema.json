{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcftrading.example/schemas/rhc-candidate-event-evidence-v1.json",
  "title": "Robinhood Chain wallet candidate event evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "chain_id",
    "project_entity_id",
    "wallet",
    "nft_contract",
    "token_standard",
    "primary_route",
    "project_eligibility_status",
    "all_zero_cost_allocations_reconciled",
    "block_number",
    "block_hash",
    "canonicality_status",
    "transaction_hash",
    "log_index",
    "tx_from",
    "minter",
    "payer",
    "economic_entity_status",
    "payer_entity_relation",
    "quantity",
    "unit_mint_price_wei",
    "drop_stage_index",
    "receipt_status",
    "zero_transfer_recipient",
    "zero_transfer_count",
    "zero_transfer_quantity",
    "source_head_block",
    "source_manifest_sha256"
  ],
  "properties": {
    "chain_id": {"const": 4663},
    "project_entity_id": {"type": "string", "minLength": 1},
    "wallet": {"type": "string", "pattern": "^0x[a-f0-9]{40}$"},
    "nft_contract": {"type": "string", "pattern": "^0x[a-f0-9]{40}$"},
    "token_standard": {"enum": ["ERC721", "ERC1155"]},
    "primary_route": {"enum": ["SEADROP_PUBLIC"]},
    "project_eligibility_status": {"const": "STRICT_COMPARABLE_PASS"},
    "all_zero_cost_allocations_reconciled": {"const": true},
    "block_number": {"type": "integer", "minimum": 0},
    "block_hash": {"type": "string", "pattern": "^0x[a-f0-9]{64}$"},
    "canonicality_status": {"const": "FINALIZED_CANONICAL"},
    "transaction_hash": {"type": "string", "pattern": "^0x[a-f0-9]{64}$"},
    "log_index": {"type": "integer", "minimum": 0},
    "tx_from": {"type": "string", "pattern": "^0x[a-f0-9]{40}$"},
    "minter": {"type": "string", "pattern": "^0x[a-f0-9]{40}$"},
    "payer": {"type": "string", "pattern": "^0x[a-f0-9]{40}$"},
    "economic_entity_status": {"enum": ["SELF_FUNDED", "SAME_ENTITY_PROVEN"]},
    "payer_entity_relation": {"enum": ["SELF", "SAME_ENTITY_PROVEN"]},
    "payer_relation_evidence_id": {"type": "string"},
    "erc4337_sender": {"type": ["string", "null"]},
    "paymaster": {"type": ["string", "null"]},
    "quantity": {"type": "integer", "minimum": 1},
    "unit_mint_price_wei": {"type": "integer", "minimum": 1},
    "drop_stage_index": {"const": 0},
    "receipt_status": {"enum": ["1", "success", "ok"]},
    "zero_transfer_recipient": {"type": "string", "pattern": "^0x[a-f0-9]{40}$"},
    "zero_transfer_count": {"type": "integer", "minimum": 1},
    "zero_transfer_quantity": {"type": "integer", "minimum": 1},
    "source_head_block": {"type": "integer", "minimum": 0},
    "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
